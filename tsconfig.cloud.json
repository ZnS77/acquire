{
  // Compiles the pure engine to CommonJS so the WeChat cloud function can
  // `require('./engine/acquire')`. Run via: npm run build:cloud
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "cloud/functions/dispatch/engine",
    "rootDir": "src/engine",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "esModuleInterop": true,
    "types": []
  },
  "include": ["src/engine/**/*.ts"],
  "exclude": ["src/engine/**/*.test.ts"]
}
