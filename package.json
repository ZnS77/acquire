{
  "name": "acquire-online",
  "version": "0.1.0",
  "private": true,
  "description": "并购风云联机版 MVP — pure-TS Acquire rule engine + browser hot-seat renderer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/acquire/",
    "build:cloud": "tsc -p tsconfig.cloud.json",
    "preview": "vite preview --host",
    "server": "tsx src/server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "ws": "^8.21.0"
  }
}
