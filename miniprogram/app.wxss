page {
  --bg: #0f1622;
  --panel: #182234;
  --panel2: #1f2c42;
  --ink: #e8eef7;
  --muted: #93a4bd;
  --line: #2c3a54;
  --accent: #4da3ff;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.page { padding: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; margin: 16rpx 0 24rpx; }
.tag {
  font-size: 22rpx; background: var(--accent); color: #06101f;
  padding: 2rpx 12rpx; border-radius: 16rpx; vertical-align: middle;
}
.card {
  background: var(--panel); border: 1rpx solid var(--line);
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
}
.input {
  background: var(--panel2); border: 1rpx solid var(--line);
  border-radius: 12rpx; padding: 18rpx; margin-bottom: 18rpx; color: var(--ink);
}
.btn {
  background: var(--panel2); color: var(--ink); border: 1rpx solid var(--line);
  border-radius: 12rpx; margin: 0; font-size: 30rpx;
}
.btn.primary { background: var(--accent); color: #06101f; font-weight: 600; }
.btn::after { border: none; }
.tip { color: var(--muted); font-size: 26rpx; margin-top: 12rpx; min-height: 36rpx; }
